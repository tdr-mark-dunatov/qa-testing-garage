{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🔧 Python: FastAPI Backend",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/apps/webhook-inspector/api",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/webhook-inspector/api"
      },
      "console": "integratedTerminal"
    }
  ]
}
