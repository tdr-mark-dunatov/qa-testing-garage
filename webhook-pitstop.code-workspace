{
  "folders": [
    {
      "name": "🏁 Webhook Pitstop (Root)",
      "path": "."
    },
    {
      "name": "📡 API (FastAPI + Poetry)",
      "path": "apps/api"
    },
    {
      "name": "🌐 Web (React + Vite)",
      "path": "apps/web"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/node_modules": true,
      "**/.git": true,
      "**/venv": true,
      "**/.venv": true,
      "**/dist": true,
      "**/.DS_Store": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/venv": true,
      "**/.venv": true,
      "**/dist": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder:📡 API (FastAPI + Poetry)}/.venv/bin/python",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.formatting.provider": "black",
    "[python]": {
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "[javascript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-azuretools.vscode-docker"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🏁 Run Backend (Poetry)",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
        "cwd": "${workspaceFolder:📡 API (FastAPI + Poetry)}",
        "env": {
          "DATABASE_URL": "sqlite:///./data/pitstop.db"
        },
        "justMyCode": false
      },
      {
        "name": "🏁 Run Backend (Docker)",
        "type": "docker",
        "request": "launch",
        "preLaunchTask": "docker-run: debug",
        "python": {
          "pathMappings": [
            {
              "localRoot": "${workspaceFolder}/apps/api",
              "remoteRoot": "/app"
            }
          ],
          "projectType": "fastapi"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🏁 Start API (Poetry)",
        "type": "shell",
        "command": "poetry run uvicorn main:app --reload --host 0.0.0.0 --port 8000",
        "options": {
          "cwd": "${workspaceFolder}/apps/api"
        },
        "problemMatcher": [],
        "isBackground": true,
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
          "showReuseMessage": true,
          "clear": false
        }
      },
      {
        "label": "🌐 Start Web (Vite)",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder}/apps/web"
        },
        "problemMatcher": [],
        "isBackground": true,
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
          "showReuseMessage": true,
          "clear": false
        }
      },
      {
        "label": "🚀 Start Both Apps (Dev Mode)",
        "dependsOn": ["🏁 Start API (Poetry)", "🌐 Start Web (Vite)"],
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "shared"
        }
      },
      {
        "label": "🐳 Docker: Build & Start",
        "type": "shell",
        "command": "docker-compose up --build",
        "options": {
          "cwd": "${workspaceFolder}/docker"
        },
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "dedicated"
        }
      },
      {
        "label": "🐳 Docker: Stop",
        "type": "shell",
        "command": "docker-compose down",
        "options": {
          "cwd": "${workspaceFolder}/docker"
        },
        "problemMatcher": []
      },
      {
        "label": "📦 Install: Backend Dependencies",
        "type": "shell",
        "command": "poetry install",
        "options": {
          "cwd": "${workspaceFolder}/apps/api"
        },
        "problemMatcher": []
      },
      {
        "label": "📦 Install: Frontend Dependencies",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder}/apps/web"
        },
        "problemMatcher": []
      },
      {
        "label": "📦 Install: All Dependencies",
        "dependsOn": ["📦 Install: Backend Dependencies", "📦 Install: Frontend Dependencies"],
        "problemMatcher": []
      }
    ]
  }
}
